# PostgreSQL usado pelo Docker Compose.
POSTGRES_USER=extrato
POSTGRES_PASSWORD=defina-uma-senha-forte
POSTGRES_DB=extrato_mensal
DB_PORT=5433

# Aplicação web.
WEB_PORT=3000

# Use false apenas no desenvolvimento local via HTTP.
# Em produção com HTTPS, mantenha true.
SECURE_COOKIES=false

# Diretório privado fora de /public. No Docker, um volume persistente é usado.
PRIVATE_STORAGE_ROOT=./storage

# Envio server-side de redefinição de senha. Nunca use prefixo NEXT_PUBLIC_.
APP_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Gestão Administrativa <nao-responda@empresa.com>"
