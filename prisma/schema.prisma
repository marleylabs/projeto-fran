generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Guarda cada extração de PDF processada. O resultado completo (colaboradores/linhas,
// totais, avisos) fica em "data" como JSON — evita normalizar duas estruturas bem
// diferentes (Extrato Mensal em blocos vs Relatório Sintético em tabela) em tabelas
// separadas, mantendo simples adicionar um terceiro formato no futuro.
model Upload {
  id                 String   @id @default(cuid())
  fileName           String
  formato            String
  createdAt          DateTime @default(now())
  totalColaboradores Int      @default(0)
  liquidoGeral       Float    @default(0)
  // Identificam a empresa (CNPJ/código) e o período (Competência ou período do
  // Relatório Sintético) para detectar upload duplicado do mesmo período.
  // Ficam nulos quando o PDF não tinha essa informação legível.
  empresaChave       String?
  periodoChave       String?
  data               Json

  @@index([formato, empresaChave, periodoChave])
}

// Contas de acesso ao sistema. Sem cadastro público — usuários são criados por
// quem já está logado, na tela "Usuários". Senha nunca fica em texto puro,
// somente o hash (bcrypt).
model User {
  id                 String                     @id @default(cuid())
  email              String                     @unique
  passwordHash       String
  name               String?
  active             Boolean                    @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime                   @default(now())
  sessions           Session[]
  roles              UserRole[]
  financialRecords   FinancialRecord[]          @relation("FinancialRecordCreator")
  uploadedDocuments  FinancialDocumentFile[]    @relation("DocumentUploader")
  validationReviews  DocumentValidationReview[] @relation("ValidationReviewer")
  initiatedApprovals ApprovalRequest[]          @relation("ApprovalInitiator")
  approvalActions    ApprovalStepInstance[]     @relation("ApprovalActor")
  foodBatches        FoodBatch[]
  transitVoucherMaps TransitVoucherMap[]
  foodBatchRevisions FoodBatchRevision[]
  deletedFoodOccurrences FoodMealOccurrence[] @relation("FoodOccurrenceDeleter")
  cancelledFoodBatches FoodBatch[] @relation("FoodBatchCanceller")
  deletedTransitAllocations TransitVoucherAllocation[] @relation("TransitAllocationDeleter")
  cancelledTransitMaps TransitVoucherMap[] @relation("TransitMapCanceller")
  passwordResetTokens PasswordResetToken[]
  administrativeActions UserAccessAudit[] @relation("UserAccessAuditActor")
  receivedAdministrativeActions UserAccessAudit[] @relation("UserAccessAuditTarget")
  trainingExpensesCreated TrainingExpense[] @relation("TrainingExpenseCreator")
  trainingExpensesCancelled TrainingExpense[] @relation("TrainingExpenseCanceller")
  trainingExpenseRevisions TrainingExpenseRevision[] @relation("TrainingExpenseRevisionEditor")
  transitHolidays TransitVoucherHoliday[] @relation("TransitHolidayCreator")
  breakfastMaps BreakfastMap[] @relation("BreakfastMapCreator")
  cancelledBreakfastMaps BreakfastMap[] @relation("BreakfastMapCanceller")
  deletedBreakfastAllocations BreakfastAllocation[] @relation("BreakfastAllocationDeleter")
  breakfastHolidays BreakfastHoliday[] @relation("BreakfastHolidayCreator")
  basicBasketMaps BasicBasketMap[] @relation("BasicBasketMapCreator")
  cancelledBasicBasketMaps BasicBasketMap[] @relation("BasicBasketMapCanceller")
  deletedBasicBasketAllocations BasicBasketAllocation[] @relation("BasicBasketAllocationDeleter")
  basicBasketPointMirrorImports BasicBasketPointMirrorImport[] @relation("BasicBasketPointMirrorImportCreator")
  healthPlanInvoices HealthPlanInvoice[] @relation("HealthPlanInvoiceCreator")
  cancelledHealthPlanInvoices HealthPlanInvoice[] @relation("HealthPlanInvoiceCanceller")
}

// Token de redefinição de senha enviado por e-mail. Só o hash do token é gravado (o valor puro vai apenas no link);
// expira em expiresAt e é de uso único (usedAt preenchido ao consumir).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

// Trilha de auditoria de ações administrativas sobre contas de usuário (ex.: TEMPORARY_PASSWORD_SET,
// PASSWORD_RESET_SENT). details nunca deve conter senha. Restrict nos usuários preserva o histórico.
model UserAccessAudit {
  id           String   @id @default(cuid())
  actorId      String
  targetUserId String
  action       String
  details      Json?
  createdAt    DateTime @default(now())
  actor        User     @relation("UserAccessAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUser   User     @relation("UserAccessAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
}

// Sessão de login, verificada no banco a cada requisição (não é um JWT
// autocontido) para permitir revogar o acesso a qualquer momento.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// RBAC persistido e verificado no backend. As chaves são estáveis para uso no
// código; nomes e descrições podem ser apresentados de forma amigável na UI.
model Role {
  id                  String                 @id @default(cuid())
  key                 String                 @unique
  name                String
  description         String?
  isSystem            Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  users               UserRole[]
  permissions         RolePermission[]
  approvalPolicySteps ApprovalPolicyStep[]
  approvalInstances   ApprovalStepInstance[]
}

// Permissão atômica do RBAC (chave estável usada no código, ex.: PERMISSIONS.ROLES_MANAGE); ligada a papéis via RolePermission.
model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

// Associação N:N usuário × papel.
model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

// Associação N:N papel × permissão.
model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

// Empresa do grupo (CNPJ em taxId). Usada como "empresa" no rateio dos benefícios (Allocation.companyId) e
// como empresa padrão nos *EmployeeConfig.
model Company {
  id               String            @id @default(cuid())
  legalName        String
  tradeName        String?
  taxId            String            @unique
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  branches         Branch[]
  projects         Project[]
  contracts        Contract[]
  costCenters      CostCenter[]
  departments      Department[]
  financialRecords FinancialRecord[]
  approvalPolicies ApprovalPolicy[]
  transitVoucherAllocations TransitVoucherAllocation[]
  transitVoucherEmployeeConfigs TransitVoucherEmployeeConfig[]
  breakfastAllocations BreakfastAllocation[]
  breakfastEmployeeConfigs BreakfastEmployeeConfig[]
  basicBasketAllocations BasicBasketAllocation[]
  basicBasketEmployeeConfigs BasicBasketEmployeeConfig[]
  healthPlanAllocations HealthPlanAllocation[]
  foodMealOccurrences FoodMealOccurrence[]
}

// Filial de uma Company (código único por empresa). Estrutura do kernel financeiro; uso opcional em FinancialRecord.
model Branch {
  id               String            @id @default(cuid())
  companyId        String
  code             String
  name             String
  taxId            String?           @unique
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  financialRecords FinancialRecord[]

  @@unique([companyId, code])
  @@index([companyId])
}

// Fornecedor do kernel financeiro original (endereço/dados bancários em JSON). Os módulos de Despesas usam
// AdministrativeEntity como favorecido; Supplier permanece para os vínculos legados de Contas a Pagar.
model Supplier {
  id               String            @id @default(cuid())
  legalName        String
  tradeName        String?
  taxId            String?           @unique
  email            String?
  phone            String?
  address          Json?
  bankDetails      Json?
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  contracts        Contract[]
  financialRecords FinancialRecord[]
}

// Cadastro administrativo genérico de entidades e favorecidos. Mantido
// separado de Supplier para não alterar os vínculos atuais de Contas a Pagar.
model AdministrativeEntity {
  id               String                @id @default(cuid())
  cnpj             String?               @db.VarChar(14)
  legalName        String
  tradeName        String
  activityArea     String
  appliesProjeta   Boolean
  appliesBoinga    Boolean
  locality         String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  financialRecords FinancialRecord[]
  foodBatches      FoodBatch[]
  foodPriceConfigs FoodUnitPriceConfig[]
  foodAllocations  FoodAllocation[]
  transitVoucherMaps TransitVoucherMap[]
  transitVoucherAllocations TransitVoucherAllocation[]
  breakfastMaps    BreakfastMap[]
  breakfastAllocations BreakfastAllocation[]
  basicBasketMaps  BasicBasketMap[]
  basicBasketAllocations BasicBasketAllocation[]
  healthPlanInvoices HealthPlanInvoice[]
  healthPlanAllocations HealthPlanAllocation[]
  trainingProposals TrainingProposal[]
  trainings        Training[]
  trainingExpenses TrainingExpense[]

  @@index([cnpj])
  @@index([activityArea])
  @@index([locality])
}

// Projeto de uma Company (código único por empresa); dimensão opcional de classificação do FinancialRecord.
model Project {
  id               String            @id @default(cuid())
  companyId        String
  code             String
  name             String
  description      String?
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  contracts        Contract[]
  financialRecords FinancialRecord[]

  @@unique([companyId, code])
  @@index([companyId])
}

// Contrato de uma Company, opcionalmente ligado a fornecedor/projeto; amount é o valor contratado (opcional).
model Contract {
  id               String            @id @default(cuid())
  companyId        String
  supplierId       String?
  projectId        String?
  code             String
  name             String
  startDate        DateTime?
  endDate          DateTime?
  amount           Decimal?          @db.Decimal(19, 4)
  currency         String            @default("BRL") @db.Char(3)
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  supplier         Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  project          Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  financialRecords FinancialRecord[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([supplierId])
  @@index([projectId])
}

// Centro de custo estruturado do kernel financeiro. Atenção: os rateios dos benefícios usam o texto
// FoodEmployee.costCenter (snapshot em String), não esta tabela.
model CostCenter {
  id               String            @id @default(cuid())
  companyId        String
  code             String
  name             String
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  financialRecords FinancialRecord[]

  @@unique([companyId, code])
  @@index([companyId])
}

// Departamento estruturado do kernel financeiro; os rateios usam o texto do cadastro do colaborador, não esta tabela.
model Department {
  id               String            @id @default(cuid())
  companyId        String
  code             String
  name             String
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  financialRecords FinancialRecord[]

  @@unique([companyId, code])
  @@index([companyId])
}

// Categoria de despesa em árvore (parentId = categoria pai); código único global.
model Category {
  id               String            @id @default(cuid())
  parentId         String?
  code             String            @unique
  name             String
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  parent           Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children         Category[]        @relation("CategoryHierarchy")
  financialRecords FinancialRecord[]

  @@index([parentId])
}

// Conta contábil (plano de contas) para classificação do FinancialRecord.
model LedgerAccount {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  financialRecords FinancialRecord[]
}

// ===== Estados do FinancialRecord =====
// Cada dimensão do ciclo de vida da obrigação financeira tem seu próprio enum/campo, evoluindo de forma
// independente (documento, extração, validação, aprovação, pagamento, comprovante, conciliação, rateio, contabilidade).
// Ciclo de vida geral do registro (cancelado/arquivado não some do banco).
enum RecordLifecycleState {
  ACTIVE
  CANCELLED
  ARCHIVED
}

// Situação do documento fiscal anexado à obrigação.
enum DocumentState {
  PENDING
  ATTACHED
  REJECTED
}

// Situação da extração (OCR/parse) dos documentos anexados.
enum ExtractionState {
  NOT_STARTED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

// Situação da validação humana dos dados extraídos.
enum ValidationState {
  PENDING
  IN_REVIEW
  VALIDATED
  REJECTED
}

// Situação da aprovação (NOT_REQUIRED quando nenhuma ApprovalPolicy se aplica).
enum ApprovalState {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

// Situação do pagamento da obrigação.
enum PaymentState {
  PENDING
  SCHEDULED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

// Situação do comprovante de pagamento.
enum ReceiptState {
  PENDING
  ATTACHED
  VALIDATED
  REJECTED
}

// Situação da conciliação bancária.
enum ReconciliationState {
  PENDING
  MATCHED
  DIVERGENT
}

// Situação do rateio (alocação por centro de custo/departamento).
enum AllocationState {
  PENDING
  COMPLETED
}

// Situação da exportação contábil.
enum AccountingState {
  PENDING
  READY
  EXPORTED
  ERROR
}

// Tipo do arquivo anexado a uma obrigação (FinancialDocumentFile.kind).
enum FinancialFileKind {
  INVOICE
  TAX_INVOICE
  BOLETO
  RECEIPT
  XML
  SPREADSHEET
  SUPPORTING
  OTHER
}

// Estado de um job da fila de extração (DocumentExtractionJob) processado pelo scripts/document-worker.ts.
enum ExtractionJobState {
  PENDING
  PROCESSING
  SUCCESS
  PARTIAL
  FAILED
  REVIEW_REQUIRED
}

// Decisão do revisor em DocumentValidationReview.
enum ValidationDecision {
  VALIDATED
  REJECTED
  CORRECTION_REQUESTED
}

// Status geral de uma solicitação de aprovação (ApprovalRequest).
enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CORRECTION_REQUESTED
  CANCELLED
}

// Status de uma etapa de aprovação: WAITING = etapa futura, PENDING = etapa atual aguardando ação.
enum ApprovalStepStatus {
  WAITING
  PENDING
  APPROVED
  REJECTED
  CORRECTION_REQUESTED
  SKIPPED
}

// Status de um lote/lançamento de benefício. Apesar do nome "Food", é reutilizado por TransitVoucherMap,
// BreakfastMap e BasicBasketMap. READY = sem pendências, apto a gerar/atualizar o FinancialRecord.
enum FoodBatchStatus {
  UNDER_REVIEW
  WITH_INCONSISTENCIES
  READY
}

// Contador anual para o identificador sequencial do FinancialRecord. Incrementado dentro da transação de criação
// (src/modules/accounts-payable/server/financialRecords.ts): nextNumber é o PRÓXIMO número livre do ano.
model FinancialSequence {
  year       Int      @id
  nextNumber Int      @default(1)
  updatedAt  DateTime @updatedAt
}

// ===== Kernel financeiro =====
// Obrigação financeira (conta a pagar) — destino comum de todos os lançamentos de benefícios (FoodBatch,
// TransitVoucherMap, BreakfastMap, BasicBasketMap, HealthPlanInvoice, TrainingExpense: relação 1:1 opcional).
// identifier é legível e gerado de sequenceYear/sequenceNumber (FinancialSequence). administrativeEntityId é o
// favorecido; os demais vínculos (empresa, fornecedor, projeto...) são dimensões opcionais do kernel original.
model FinancialRecord {
  id                     String                     @id @default(cuid())
  identifier             String                     @unique
  sequenceYear           Int
  sequenceNumber         Int
  companyId              String?
  branchId               String?
  supplierId             String?
  administrativeEntityId String
  projectId              String?
  contractId             String?
  costCenterId           String?
  departmentId           String?
  categoryId             String?
  ledgerAccountId        String?
  createdByUserId        String
  documentType           String?
  documentNumber         String?
  description            String?
  issueDate              DateTime?
  receivedAt             DateTime                   @default(now())
  dueDate                DateTime?
  competenceDate         DateTime?
  // Valores monetários sempre em Decimal(19,4); netAmount é opcional (calculado/informado quando aplicável).
  grossAmount            Decimal                    @db.Decimal(19, 4)
  discountAmount         Decimal                    @default(0) @db.Decimal(19, 4)
  taxAmount              Decimal                    @default(0) @db.Decimal(19, 4)
  withholdingAmount      Decimal                    @default(0) @db.Decimal(19, 4)
  netAmount              Decimal?                   @db.Decimal(19, 4)
  currency               String                     @default("BRL") @db.Char(3)
  lifecycleState         RecordLifecycleState       @default(ACTIVE)
  documentState          DocumentState              @default(PENDING)
  extractionState        ExtractionState            @default(NOT_STARTED)
  validationState        ValidationState            @default(PENDING)
  approvalState          ApprovalState              @default(PENDING)
  paymentState           PaymentState               @default(PENDING)
  receiptState           ReceiptState               @default(PENDING)
  reconciliationState    ReconciliationState        @default(PENDING)
  allocationState        AllocationState            @default(PENDING)
  accountingState        AccountingState            @default(PENDING)
  notes                  String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  company                Company?                   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  branch                 Branch?                    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  supplier               Supplier?                  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  administrativeEntity   AdministrativeEntity       @relation(fields: [administrativeEntityId], references: [id], onDelete: Restrict)
  project                Project?                   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contract               Contract?                  @relation(fields: [contractId], references: [id], onDelete: SetNull)
  costCenter             CostCenter?                @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  department             Department?                @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  category               Category?                  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  ledgerAccount          LedgerAccount?             @relation(fields: [ledgerAccountId], references: [id], onDelete: SetNull)
  createdBy              User                       @relation("FinancialRecordCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  files                  FinancialDocumentFile[]
  validationReviews      DocumentValidationReview[]
  approvalRequests       ApprovalRequest[]
  foodBatch              FoodBatch?
  transitVoucherMap      TransitVoucherMap?
  breakfastMap           BreakfastMap?
  basicBasketMap         BasicBasketMap?
  healthPlanInvoice      HealthPlanInvoice?
  trainingExpense        TrainingExpense?

  @@unique([sequenceYear, sequenceNumber])
  @@index([companyId, dueDate])
  @@index([supplierId])
  @@index([administrativeEntityId])
  @@index([paymentState, dueDate])
  @@index([approvalState, createdAt])
}

// ===== Alimentação (Refeição) =====
// Preço unitário da refeição por fornecedor (AdministrativeEntity) e localidade (MA/PA). Vigência opcional
// (effectiveYear/effectiveMonth): vale a configuração ativa mais recente com vigência <= competência; null = sem início.
model FoodUnitPriceConfig {
  id                     String                @id @default(cuid())
  unitPrice              Decimal               @db.Decimal(19, 4)
  locality               String?               @db.VarChar(10)
  administrativeEntityId String
  effectiveYear          Int?
  effectiveMonth         Int?
  active                 Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  administrativeEntity   AdministrativeEntity @relation(fields: [administrativeEntityId], references: [id], onDelete: Restrict)

  @@index([active, locality, administrativeEntityId, effectiveYear, effectiveMonth])
}

// Competência (ano/mês) da Alimentação; agrupa os lotes (FoodBatch) e as alocações.
model FoodCompetence {
  id        String      @id @default(cuid())
  year      Int
  month     Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  batches   FoodBatch[]
  allocations FoodAllocation[]

  @@unique([year, month])
  @@index([year, month])
}

// Lote de Alimentação: um upload (ou lançamento manual) por competência × localidade × fornecedor × ciclo.
// Cada reprocessamento cria nova version; só a linha com current = true vale. O arquivo original fica no
// storage privado (storageKey), com sha256 para rastreabilidade. Cancelamento é lógico (cancelled*).
model FoodBatch {
  id                     String               @id @default(cuid())
  competenceId           String
  administrativeEntityId String
  uploadedByUserId       String
  financialRecordId      String?              @unique
  locality               String               @db.VarChar(10)
  // Ciclo do lote em MA: 1 = dias 1 a 15, 2 = dia 16 ao fim do mês; 0 = lote mensal (PA ou histórico).
  // Ver src/modules/accounts-payable/food/cycles.ts.
  cycle                  Int                  @default(0)
  version                Int
  current                Boolean              @default(true)
  status                 FoodBatchStatus
  originalName           String
  storageKey             String               @unique
  mimeType               String
  sizeBytes              Int
  sha256                 String
  unitPrice              Decimal              @db.Decimal(19, 4)
  totalRows              Int
  validRows              Int
  invalidRows            Int
  totalAmount            Decimal              @db.Decimal(19, 4)
  processedAt            DateTime             @default(now())
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  cancelledAt            DateTime?
  cancelledByUserId      String?
  cancellationReason     String?
  competence             FoodCompetence       @relation(fields: [competenceId], references: [id], onDelete: Restrict)
  administrativeEntity   AdministrativeEntity @relation(fields: [administrativeEntityId], references: [id], onDelete: Restrict)
  uploadedBy             User                 @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  cancelledBy            User?                @relation("FoodBatchCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  financialRecord        FinancialRecord?     @relation(fields: [financialRecordId], references: [id], onDelete: Restrict)
  allocations            FoodAllocation[]
  mealOccurrences        FoodMealOccurrence[]
  issues                 FoodBatchIssue[]
  revisions              FoodBatchRevision[]

  @@unique([competenceId, locality, administrativeEntityId, cycle, version])
  @@index([competenceId, locality, administrativeEntityId, cycle, current])
  @@index([administrativeEntityId])
}

// Linha de rateio da Alimentação (formato legado por linha da planilha): valor por colaborador/departamento
// com snapshot do preço unitário.
model FoodAllocation {
  id               String    @id @default(cuid())
  batchId          String
  competenceId     String
  administrativeEntityId String
  sourceRow        Int
  sourceIdentifier String?
  employeeName     String
  department       String
  locality         String    @db.VarChar(10)
  unitPrice        Decimal   @db.Decimal(19, 4)
  amount           Decimal   @db.Decimal(19, 4)
  createdAt        DateTime  @default(now())
  batch            FoodBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  competence       FoodCompetence @relation(fields: [competenceId], references: [id], onDelete: Restrict)
  administrativeEntity AdministrativeEntity @relation(fields: [administrativeEntityId], references: [id], onDelete: Restrict)

  @@index([batchId, department])
  @@index([batchId, employeeName])
  @@index([competenceId, locality, administrativeEntityId])
}

// Inconsistência encontrada ao processar um lote de Alimentação (linha, código e mensagem para o usuário).
model FoodBatchIssue {
  id           String    @id @default(cuid())
  batchId      String
  sourceRow    Int?
  employeeName String?
  code         String
  message      String
  createdAt    DateTime  @default(now())
  batch        FoodBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, sourceRow])
}

// Cadastro Mestre de colaboradores. Apesar do nome histórico "FoodEmployee", é compartilhado por todos os
// benefícios (VT, Café da Manhã, Cesta Básica, Plano de Saúde, Treinamentos). normalizedName é a chave de
// match por nome (sem acento/caixa). Não é apagado: inativação via active e unificação de duplicados via mergedIntoId.
model FoodEmployee {
  id             String               @id @default(cuid())
  officialName   String
  normalizedName String               @unique
  department     String
  jobTitle       String               @default("")
  costCenter     String               @default("")
  // CPF: só os 11 dígitos (sem pontuação); null = ainda não informado. Dado pessoal — omitido por
  // padrão no PrismaClient (ver src/lib/db/prisma.ts); só é lido onde for explicitamente selecionado.
  cpf            String?              @unique
  // Data de Admissão: só dia/mês/ano (DATE, sem hora/timezone); null = ainda não informada.
  // Dado cadastral pessoal — também omitido por padrão no PrismaClient. Não é chave de match.
  admissionDate  DateTime?            @db.Date
  active         Boolean              @default(true)
  // Quando preenchido, este cadastro foi unificado (merge) no colaborador indicado e deixa de aparecer nas listas.
  mergedIntoId   String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  aliases        FoodEmployeeAlias[]
  occurrences    FoodMealOccurrence[]
  transitAllocations TransitVoucherAllocation[]
  breakfastAllocations BreakfastAllocation[]
  trainingExpenseParticipations TrainingExpenseParticipant[]
  transitConfig  TransitVoucherEmployeeConfig?
  breakfastConfig BreakfastEmployeeConfig?
  basicBasketAllocations BasicBasketAllocation[]
  basicBasketConfig BasicBasketEmployeeConfig?
  healthPlanAllocations HealthPlanAllocation[]
  mergedInto     FoodEmployee?        @relation("FoodEmployeeMerges", fields: [mergedIntoId], references: [id], onDelete: Restrict)
  mergedEmployees FoodEmployee[]      @relation("FoodEmployeeMerges")

  @@index([department, active])
  @@index([mergedIntoId])
}

// Nome alternativo (como veio em planilhas/PDFs) já associado a um colaborador; acelera o match nos próximos uploads.
model FoodEmployeeAlias {
  id              String       @id @default(cuid())
  employeeId      String
  sourceName      String
  normalizedAlias String       @unique
  createdAt       DateTime     @default(now())
  employee        FoodEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// Status de validação do vínculo ocorrência → colaborador (automático ou confirmado pelo usuário).
enum FoodOccurrenceValidationStatus {
  PENDING
  AUTO_MATCHED
  CONFIRMED
}

// Como a ocorrência foi associada ao colaborador (exato, normalizado, apelido, aproximado ou manual).
enum FoodOccurrenceMatchMethod {
  UNMATCHED
  EXACT
  NORMALIZED
  ALIAS
  FUZZY
  MANUAL
}

// Destino da ocorrência no cálculo: válida, duplicada ou ignorada.
enum FoodOccurrenceDisposition {
  VALID
  DUPLICATE
  IGNORED
}

// Origem de uma linha: importada de arquivo (UPLOAD) ou lançada à mão (MANUAL).
enum EntryOrigin {
  UPLOAD
  MANUAL
}

// Ocorrência de refeição (uma linha por colaborador × dia) de um lote de Alimentação. Guarda o nome recebido
// e o oficial, o resultado do match, flags de duplicidade e o valor (snapshot do preço). Exclusão é lógica
// (deletedAt/deletedByUserId/deletionReason).
model FoodMealOccurrence {
  id                     String                         @id @default(cuid())
  batchId                String
  employeeId             String?
  sourceRow              Int
  occurredOn             DateTime?                      @db.Date
  mealQuantity           Int                            @default(1)
  receivedName           String
  normalizedReceivedName String
  officialName           String?
  receivedDepartment     String
  confirmedDepartment    String?
  invoiceEmission        String?
  restaurantName         String?
  // Snapshot histórico SÓ para agrupar o rateio (Fase 7E.2), capturado no servidor no lançamento/finalização (ou ao
  // trocar o colaborador numa edição). Não participa de nenhum cálculo. null = lançamento anterior à captura
  // ("Sem centro de custo" / "Sem empresa" no rateio) — sem backfill pelo cadastro atual.
  //   costCenter: FoodEmployee.costCenter no momento (MA e PA).
  //   companyId/company: MA = empresa padrão do colaborador no Café da Manhã (BreakfastEmployeeConfig) no momento;
  //   PA = não gravado (a Empresa continua DERIVADA da Emissão NF salva, invoiceEmission).
  costCenter             String?
  companyId              String?
  company                String?
  duplicateCandidate     Boolean                        @default(false)
  duplicateConfirmed     Boolean                        @default(false)
  included               Boolean                        @default(true)
  validationStatus       FoodOccurrenceValidationStatus @default(PENDING)
  matchMethod            FoodOccurrenceMatchMethod       @default(UNMATCHED)
  disposition            FoodOccurrenceDisposition       @default(VALID)
  unitPrice              Decimal                        @db.Decimal(19, 4)
  amount                 Decimal                        @db.Decimal(19, 4)
  origin                 EntryOrigin                    @default(UPLOAD)
  createdByUserId        String?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  deletedAt              DateTime?
  deletedByUserId        String?
  deletionReason         String?
  batch                  FoodBatch                      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  employee               FoodEmployee?                  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  companyRef             Company?                       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  deletedBy              User?                          @relation("FoodOccurrenceDeleter", fields: [deletedByUserId], references: [id], onDelete: Restrict)

  @@index([batchId, normalizedReceivedName])
  @@index([batchId, occurredOn, employeeId])
  @@index([batchId, deletedAt])
}

// Auditoria de edição de um lote já processado: total antes/depois e diff das mudanças em JSON.
model FoodBatchRevision {
  id             String    @id @default(cuid())
  batchId        String
  editedByUserId String
  revision       Int
  previousTotal  Decimal   @db.Decimal(19, 4)
  newTotal       Decimal   @db.Decimal(19, 4)
  changes        Json
  createdAt      DateTime  @default(now())
  batch          FoodBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  editedBy       User      @relation(fields: [editedByUserId], references: [id], onDelete: Restrict)

  @@unique([batchId, revision])
  @@index([batchId, createdAt])
}

// ===== Vale Transporte =====
// Competência do VT; fareUnitPrice é a tarifa da passagem vigente no mês, aplicada a novos lançamentos.
model TransitVoucherCompetence {
  id          String                    @id @default(cuid())
  year        Int
  month       Int
  fareUnitPrice Decimal?                @db.Decimal(19, 4)
  holidays    TransitVoucherHoliday[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  maps        TransitVoucherMap[]
  allocations TransitVoucherAllocation[]

  @@unique([year, month])
}

// Lançamento de VT por competência × fornecedor (versionado: current = true é o vigente). Guarda metadados do
// arquivo importado e holidaysSnapshot (feriados usados no cálculo, congelados no lançamento).
model TransitVoucherMap {
  id                     String                   @id @default(cuid())
  competenceId           String
  administrativeEntityId String
  uploadedByUserId       String
  financialRecordId      String?                  @unique
  locality               String                   @default("MA") @db.VarChar(10)
  version                Int
  current                Boolean                  @default(true)
  status                 FoodBatchStatus
  originalName           String
  storageKey             String                   @unique
  mimeType               String
  sizeBytes              Int
  sha256                 String
  totalRows              Int
  validRows              Int
  invalidRows            Int
  totalAmount            Decimal                  @db.Decimal(19, 4)
  processedAt            DateTime                 @default(now())
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  holidaysSnapshot       Json?
  cancelledAt            DateTime?
  cancelledByUserId      String?
  cancellationReason     String?
  competence             TransitVoucherCompetence @relation(fields: [competenceId], references: [id], onDelete: Restrict)
  administrativeEntity   AdministrativeEntity     @relation(fields: [administrativeEntityId], references: [id], onDelete: Restrict)
  uploadedBy             User                     @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  cancelledBy            User?                    @relation("TransitMapCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  financialRecord        FinancialRecord?         @relation(fields: [financialRecordId], references: [id], onDelete: Restrict)
  allocations            TransitVoucherAllocation[]
  issues                 TransitVoucherIssue[]

  @@unique([competenceId, administrativeEntityId, version])
  @@index([competenceId, administrativeEntityId, current])
}

// Linha do VT por colaborador com snapshot completo (empresa, departamento, CC, passagens, tarifa e valor):
// não é recalculada se o cadastro ou a tarifa mudarem. Exclusão lógica (deleted*). Os campos monetários antigos
// (dailyAmount, previousMonthDifference, occasionalDiscounts, days) vêm do formato de planilha legado; os de
// passagens (dailyPassageQuantity ... passagesToReceive) do cálculo atual por quantidade × tarifa.
model TransitVoucherAllocation {
  id                     String                   @id @default(cuid())
  mapId                  String
  competenceId           String
  administrativeEntityId String
  sourceRow              Int
  sourceIdentifier       String?
  employeeId             String?
  company                String                   @default("Não informada")
  employeeName           String
  originalEmployeeName   String?
  department             String?
  serviceDate            DateTime?
  service                String?
  costCenter             String?
  dailyAmount            Decimal?                 @db.Decimal(19, 4)
  previousMonthDifference Decimal?                @db.Decimal(19, 4)
  occasionalDiscounts    Decimal?                 @db.Decimal(19, 4)
  days                   Decimal?                 @db.Decimal(10, 2)
  locality               String                   @default("MA") @db.VarChar(10)
  amount                 Decimal                  @db.Decimal(19, 4)
  origin                 EntryOrigin              @default(UPLOAD)
  createdByUserId        String?
  createdAt              DateTime                 @default(now())
  deletedAt              DateTime?
  deletedByUserId        String?
  deletionReason         String?
  companyId              String?
  dailyPassageQuantity   Int?
  previousPassageDifference Int?
  passageDiscount        Int?
  workingDays            Int?
  passagesToReceive      Int?
  fareUnitPrice          Decimal?                 @db.Decimal(19, 4)
  observationType        TransitObservationType?
  observationDetails     String?
  companyRef             Company?                 @relation(fields: [companyId], references: [id], onDelete: Restrict)
  map                    TransitVoucherMap        @relation(fields: [mapId], references: [id], onDelete: Cascade)
  competence             TransitVoucherCompetence @relation(fields: [competenceId], references: [id], onDelete: Restrict)
  administrativeEntity   AdministrativeEntity     @relation(fields: [administrativeEntityId], references: [id], onDelete: Restrict)
  employee               FoodEmployee?            @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  deletedBy              User?                    @relation("TransitAllocationDeleter", fields: [deletedByUserId], references: [id], onDelete: Restrict)

  @@index([mapId, employeeName])
  @@index([mapId, company, department])
  @@index([employeeId])
  @@index([competenceId, administrativeEntityId])
  @@index([mapId, deletedAt])
}

// Tipo de observação de uma linha de VT (férias ou outro motivo descrito em observationDetails).
enum TransitObservationType {
  VACATION
  OTHER
}

// Feriados marcados manualmente por competência (sem API externa) — só
// reduzem dias úteis quando caem de segunda a sexta.
model TransitVoucherHoliday {
  id              String                   @id @default(cuid())
  competenceId    String
  date            DateTime                 @db.Date
  name            String
  createdByUserId String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  competence      TransitVoucherCompetence @relation(fields: [competenceId], references: [id], onDelete: Cascade)
  createdBy       User                     @relation("TransitHolidayCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([competenceId, date])
}

// Padrão atual do colaborador para novos lançamentos — NUNCA é lido para
// recalcular lançamentos antigos (cada linha guarda seu próprio snapshot).
model TransitVoucherEmployeeConfig {
  id                   String       @id @default(cuid())
  employeeId           String       @unique
  dailyPassageQuantity Int
  defaultCompanyId     String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  employee             FoodEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  defaultCompany       Company?     @relation(fields: [defaultCompanyId], references: [id], onDelete: SetNull)

  @@index([defaultCompanyId])
}

// Pendência de importação do VT. Guarda a linha bruta, erros por campo e sugestão; ao ser corrigida pelo usuário,
// correctedData/resolvedAt/resolvedByUserId são preenchidos e a linha vira alocação.
model TransitVoucherIssue {
  id           String            @id @default(cuid())
  mapId        String
  sourceRow    Int?
  employeeName String?
  code         String
  message      String
  rawData      Json?
  fieldErrors  Json?
  suggestedData Json?
  correctedData Json?
  resolvedAt   DateTime?
  resolvedByUserId String?
  createdAt    DateTime          @default(now())
  map          TransitVoucherMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@index([mapId, sourceRow])
  @@index([mapId, resolvedAt])
}

// ===== Café da Manhã (subseção de Despesas → Alimentação) =====
// Domínio próprio, sem relação com TransitVoucher* — só reaproveita as funções puras de
// calendário/feriados nacionais (@/modules/shared) e o kernel financeiro (FinancialRecord),
// no mesmo espírito do Vale Transporte: Competência (tarifa/feriados) → Map (lançamento por
// cadastro da obrigação, com holidaysSnapshot) → Allocation (linha por colaborador, com
// snapshot completo). Café da Manhã tem sua PRÓPRIA lista de feriados manuais (BreakfastHoliday)
// — não compartilha a tabela do Vale Transporte, decisão registrada no relatório de análise.
model BreakfastCompetence {
  id          String               @id @default(cuid())
  year        Int
  month       Int
  unitPrice   Decimal?             @db.Decimal(19, 4)
  holidays    BreakfastHoliday[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  maps        BreakfastMap[]
  allocations BreakfastAllocation[]

  @@unique([year, month])
}

// Lançamento de Café da Manhã por competência × fornecedor (versionado, current = vigente), com feriados
// congelados em holidaysSnapshot e vínculo 1:1 opcional com o FinancialRecord.
model BreakfastMap {
  id                     String              @id @default(cuid())
  competenceId           String
  administrativeEntityId String
  createdByUserId        String
  financialRecordId      String?             @unique
  version                Int
  current                Boolean             @default(true)
  status                 FoodBatchStatus
  totalRows              Int
  validRows              Int
  invalidRows            Int
  totalAmount            Decimal             @db.Decimal(19, 4)
  holidaysSnapshot       Json?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  cancelledAt            DateTime?
  cancelledByUserId      String?
  cancellationReason     String?
  competence             BreakfastCompetence @relation(fields: [competenceId], references: [id], onDelete: Restrict)
  administrativeEntity   AdministrativeEntity @relation(fields: [administrativeEntityId], references: [id], onDelete: Restrict)
  createdBy              User                @relation("BreakfastMapCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cancelledBy            User?               @relation("BreakfastMapCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  financialRecord        FinancialRecord?    @relation(fields: [financialRecordId], references: [id], onDelete: Restrict)
  allocations            BreakfastAllocation[]

  @@unique([competenceId, administrativeEntityId, version])
  @@index([competenceId, administrativeEntityId, current])
}

// Linha do Café da Manhã por colaborador com snapshot completo: finalQuantity = base (dias úteis) + extra −
// desconto, amount = finalQuantity × unitPrice. Exclusão lógica (deleted*).
model BreakfastAllocation {
  id                     String              @id @default(cuid())
  mapId                  String
  competenceId           String
  administrativeEntityId String
  sourceRow              Int
  employeeId             String?
  employeeName           String
  company                String
  companyId              String?
  department             String?
  costCenter             String?
  workingDays            Int?
  baseQuantity           Int?
  extraQuantity          Int?
  discountQuantity       Int                 @default(0)
  finalQuantity          Int?
  unitPrice              Decimal?            @db.Decimal(19, 4)
  amount                 Decimal             @db.Decimal(19, 4)
  observationType        BreakfastObservationType?
  observationDetails     String?
  createdByUserId        String
  createdAt              DateTime            @default(now())
  deletedAt              DateTime?
  deletedByUserId        String?
  deletionReason         String?
  map                    BreakfastMap        @relation(fields: [mapId], references: [id], onDelete: Cascade)
  competence             BreakfastCompetence @relation(fields: [competenceId], references: [id], onDelete: Restrict)
  administrativeEntity   AdministrativeEntity @relation(fields: [administrativeEntityId], references: [id], onDelete: Restrict)
  employee               FoodEmployee?       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  companyRef             Company?            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  deletedBy              User?               @relation("BreakfastAllocationDeleter", fields: [deletedByUserId], references: [id], onDelete: Restrict)

  @@index([mapId, deletedAt])
  @@index([mapId, company, department])
  @@index([employeeId])
  @@index([competenceId, administrativeEntityId])
}

// Tipo de observação de uma linha do Café da Manhã (retroativo ou outro motivo em observationDetails).
enum BreakfastObservationType {
  RETROACTIVE
  OTHER
}

// Feriados manuais próprios do Café da Manhã (estaduais/municipais/internos) — mesma regra do
// Vale Transporte (só reduz dia útil de segunda a sexta), mas tabela própria: ver nota acima.
model BreakfastHoliday {
  id              String              @id @default(cuid())
  competenceId    String
  date            DateTime            @db.Date
  name            String
  createdByUserId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  competence      BreakfastCompetence @relation(fields: [competenceId], references: [id], onDelete: Cascade)
  createdBy       User                @relation("BreakfastHolidayCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([competenceId, date])
}

// Empresa padrão do colaborador para Café da Manhã (preferência atual; NÃO é snapshot
// histórico) — mesmo padrão do TransitVoucherEmployeeConfig, domínio próprio.
model BreakfastEmployeeConfig {
  id               String       @id @default(cuid())
  employeeId       String       @unique
  defaultCompanyId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  employee         FoodEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  defaultCompany   Company?     @relation(fields: [defaultCompanyId], references: [id], onDelete: SetNull)

  @@index([defaultCompanyId])
}

// ===== Cesta Básica (subseção de Despesas → Alimentação) =====
// Domínio próprio (não reutiliza tabelas do Café da Manhã/VT), mesmo desenho do Café da Manhã:
// Competência (ano/mês) → Map (lançamento por cadastro da obrigação/fornecedor, com snapshot da data de
// pagamento = 2ª quarta-feira) → Allocation (linha por colaborador com snapshot completo: empresa,
// departamento, centro de custo, data de admissão usada e todos os valores) → FinancialRecord.
// Calendário/feriados são só visuais (sem tabela própria; leitura dos feriados de VT e Café).
model BasicBasketCompetence {
  id          String                  @id @default(cuid())
  year        Int
  month       Int
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  maps        BasicBasketMap[]
  allocations BasicBasketAllocation[]

  @@unique([year, month])
}

// Lançamento de Cesta Básica por competência × fornecedor (versionado, current = vigente).
model BasicBasketMap {
  id                     String                @id @default(cuid())
  competenceId           String
  administrativeEntityId String
  createdByUserId        String
  financialRecordId      String?               @unique
  version                Int
  current                Boolean               @default(true)
  status                 FoodBatchStatus
  // Snapshot dos pagamentos: anterior (2ª quarta do mês anterior — corte de elegibilidade do Retroativo) e atual.
  previousPaymentDate    DateTime              @db.Date
  paymentDate            DateTime              @db.Date
  daysInMonth            Int
  totalRows              Int
  totalAmount            Decimal               @db.Decimal(19, 4)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  cancelledAt            DateTime?
  cancelledByUserId      String?
  cancellationReason     String?
  competence             BasicBasketCompetence @relation(fields: [competenceId], references: [id], onDelete: Restrict)
  administrativeEntity   AdministrativeEntity  @relation(fields: [administrativeEntityId], references: [id], onDelete: Restrict)
  createdBy              User                  @relation("BasicBasketMapCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cancelledBy            User?                 @relation("BasicBasketMapCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  financialRecord        FinancialRecord?      @relation(fields: [financialRecordId], references: [id], onDelete: Restrict)
  allocations            BasicBasketAllocation[]

  @@unique([competenceId, administrativeEntityId, version])
  @@index([competenceId, administrativeEntityId, current])
}

// Linha da Cesta Básica por colaborador com snapshot de todos os dados e valores usados no cálculo (ver blocos abaixo).
model BasicBasketAllocation {
  id                     String                @id @default(cuid())
  mapId                  String
  competenceId           String
  administrativeEntityId String
  sourceRow              Int
  employeeId             String?
  employeeName           String
  company                String
  companyId              String?
  department             String?
  costCenter             String?
  admissionDate          DateTime?             @db.Date
  // Base financeira = MÊS COMERCIAL de 30 dias (nunca os dias reais do mês; esses ficam só em BasicBasketMap.daysInMonth).
  // Retroativo de admissão (snapshot), referência = MÊS ANTERIOR à competência: mensal × retroactiveDays ÷
  // referenceCalculationDays (30), com retroactiveDays = 30 − dia comercial da admissão + 1 quando pagamento anterior <
  // admissão ≤ fim do mês anterior (dia 31 conta como 30). retroactiveEligible = retroactiveDays > 0.
  referenceCalculationDays Int
  retroactiveDays        Int
  // Espelho de Ponto (mês de referência): Falta Injustificada corta o Retroativo; Férias aplicáveis (dias comerciais
  // dentro do direito) reduzem os dias. Retroativo = mensal × retroactivePayableDays ÷ 30 (0 se houver Falta).
  retroactiveVacationDays Int                  @default(0)
  retroactiveUnjustifiedAbsence Boolean        @default(false)
  retroactivePayableDays Int
  // Férias MANUAIS da Cesta da competência (Fase 7E.3): dias financeiros (0..30) informados no lançamento para Férias
  // programadas que o Espelho ainda não tem. null = usa as Férias APROVADAS do Espelho; 0 = override explícito de zero.
  // Quando preenchido SUBSTITUI (nunca soma) as importadas em currentVacationDays; não afeta o Retroativo nem a Falta.
  manualVacationDays     Int?
  // Dias de Férias da competência vindos das ocorrências APROVADAS do Espelho (antes do override manual); null = sem
  // importação aplicada. Histórico: manual × importado × efetivo (currentVacationDays).
  importedVacationDays   Int?
  retroactiveEligible    Boolean               @default(false)
  driverBonus            Decimal               @db.Decimal(19, 4)
  agreementAmount        Decimal               @db.Decimal(19, 4)
  // Cesta da competência (snapshot): valor MENSAL cheio (configuração, 100% do mês) e valor PAGO
  // (basketAmount = mensal × currentBasketDays ÷ currentCalculationDays (30); é o que entra no Total/rateio/obrigação).
  monthlyBasketAmount    Decimal               @db.Decimal(19, 4)
  currentCalculationDays Int
  currentBasketDays      Int
  // Espelho de Ponto (mês da competência): Férias aplicáveis e Falta Injustificada (corta a Cesta do mês inteiro).
  // basketAmount = mensal × currentPayableDays ÷ 30 (0 se houver Falta). Sem importação: 0 / false / = currentBasketDays.
  currentVacationDays    Int                   @default(0)
  currentUnjustifiedAbsence Boolean            @default(false)
  currentPayableDays     Int
  // Importação do Espelho de Ponto usada (ajustes processados, sem arquivo/CPF); null = lançamento sem importação.
  pointMirrorImportId    String?
  basketAmount           Decimal               @db.Decimal(19, 4)
  retroactiveAmount      Decimal               @db.Decimal(19, 4)
  amount                 Decimal               @db.Decimal(19, 4)
  observation            String?
  createdByUserId        String
  createdAt              DateTime              @default(now())
  deletedAt              DateTime?
  deletedByUserId        String?
  deletionReason         String?
  map                    BasicBasketMap        @relation(fields: [mapId], references: [id], onDelete: Cascade)
  competence             BasicBasketCompetence @relation(fields: [competenceId], references: [id], onDelete: Restrict)
  administrativeEntity   AdministrativeEntity  @relation(fields: [administrativeEntityId], references: [id], onDelete: Restrict)
  employee               FoodEmployee?         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  companyRef             Company?              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  deletedBy              User?                 @relation("BasicBasketAllocationDeleter", fields: [deletedByUserId], references: [id], onDelete: Restrict)
  pointMirrorImport      BasicBasketPointMirrorImport? @relation(fields: [pointMirrorImportId], references: [id], onDelete: Restrict)

  @@index([mapId, deletedAt])
  @@index([employeeId])
  @@index([competenceId, administrativeEntityId])
  @@index([pointMirrorImportId])
}

// Espelho de Ponto da Cesta Básica: SÓ os ajustes já processados (por colaborador: datas de Falta Injustificada e
// de Férias no mês da competência e no mês anterior). O arquivo original, CPF e demais colunas NUNCA são gravados.
// O salvamento do lançamento referencia este registro e o servidor recalcula tudo a partir dele (o cliente não
// envia dias/valores). Registros sem lançamento vinculado são descartáveis.
model BasicBasketPointMirrorImport {
  id              String   @id @default(cuid())
  year            Int
  month           Int
  sourceRows      Int
  // { [employeeId]: { currentAbsenceDates: string[], currentVacationDates: string[], referenceAbsenceDates: string[], referenceVacationDates: string[] } }
  occurrences     Json
  createdByUserId String
  createdAt       DateTime @default(now())
  createdBy       User     @relation("BasicBasketPointMirrorImportCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  allocations     BasicBasketAllocation[]

  @@index([year, month])
  @@index([createdAt])
}

// Padrão ATUAL do colaborador para a Cesta Básica (empresa e valores pré-preenchidos na próxima
// competência). Atualizado ao salvar um lançamento; NUNCA relido para recalcular histórico.
// Retroativo e Observação não são padrão (são da competência).
model BasicBasketEmployeeConfig {
  id               String       @id @default(cuid())
  employeeId       String       @unique
  defaultCompanyId String?
  driverBonus      Decimal      @default(0) @db.Decimal(19, 4)
  agreementAmount  Decimal      @default(0) @db.Decimal(19, 4)
  basketAmount     Decimal      @default(0) @db.Decimal(19, 4)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  employee         FoodEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  defaultCompany   Company?     @relation(fields: [defaultCompanyId], references: [id], onDelete: SetNull)

  @@index([defaultCompanyId])
}
// ===== Documentos e extração =====
// Arquivo anexado a uma obrigação (nota, boleto, comprovante...). Versionado por tipo: um novo envio cria nova
// version e aponta para o anterior em supersedesFileId; active marca a versão vigente. Conteúdo no storage privado.
model FinancialDocumentFile {
  id                String                  @id @default(cuid())
  financialRecordId String
  uploadedByUserId  String
  supersedesFileId  String?
  kind              FinancialFileKind
  version           Int
  originalName      String
  storageKey        String                  @unique
  mimeType          String
  sizeBytes         Int
  sha256            String
  active            Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  financialRecord   FinancialRecord         @relation(fields: [financialRecordId], references: [id], onDelete: Cascade)
  uploadedBy        User                    @relation("DocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  supersedes        FinancialDocumentFile?  @relation("FileVersions", fields: [supersedesFileId], references: [id], onDelete: SetNull)
  replacements      FinancialDocumentFile[] @relation("FileVersions")
  extractionJobs    DocumentExtractionJob[]
  extractions       DocumentExtraction[]

  @@unique([financialRecordId, kind, version])
  @@index([financialRecordId, active])
  @@index([sha256])
}

// Job da fila de extração consumido por scripts/document-worker.ts: o worker reserva o job (PENDING → PROCESSING,
// lockedBy = id do worker), reprocessa até maxAttempts com availableAt adiado e devolve à fila jobs presos (lease).
model DocumentExtractionJob {
  id             String                @id @default(cuid())
  fileId         String
  state          ExtractionJobState    @default(PENDING)
  attempts       Int                   @default(0)
  maxAttempts    Int                   @default(3)
  availableAt    DateTime              @default(now())
  startedAt      DateTime?
  completedAt    DateTime?
  lockedBy       String?
  errorStage     String?
  errorMessage   String?
  technicalStack String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  file           FinancialDocumentFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  extraction     DocumentExtraction?

  @@index([state, availableAt])
  @@index([fileId, createdAt])
}

// Resultado de uma execução de extração (texto bruto, dados estruturados e confiança por campo).
model DocumentExtraction {
  id                String                     @id @default(cuid())
  jobId             String                     @unique
  fileId            String
  state             ExtractionJobState
  engine            String
  engineVersion     String?
  language          String?
  documentType      String?
  rawText           String?
  structuredData    Json?
  fieldConfidences  Json?
  overallConfidence Decimal?                   @db.Decimal(5, 4)
  validationResult  Json?
  createdAt         DateTime                   @default(now())
  job               DocumentExtractionJob      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  file              FinancialDocumentFile      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  validationReviews DocumentValidationReview[]

  @@index([fileId, createdAt])
  @@index([state, createdAt])
}

// Revisão humana de uma extração: snapshot do extraído, dados corrigidos e decisão do revisor.
model DocumentValidationReview {
  id                        String                    @id @default(cuid())
  financialRecordId         String
  extractionId              String
  reviewerUserId            String
  decision                  ValidationDecision
  extractedSnapshot         Json
  correctedData             Json
  lowConfidenceAcknowledged Boolean                   @default(false)
  notes                     String?
  createdAt                 DateTime                  @default(now())
  financialRecord           FinancialRecord           @relation(fields: [financialRecordId], references: [id], onDelete: Cascade)
  extraction                DocumentExtraction        @relation(fields: [extractionId], references: [id], onDelete: Restrict)
  reviewer                  User                      @relation("ValidationReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  fields                    DocumentValidationField[]

  @@index([financialRecordId, createdAt])
  @@index([reviewerUserId, createdAt])
}

// Campo individual de uma revisão (valor extraído × final, confiança e se foi alterado).
model DocumentValidationField {
  id             String                   @id @default(cuid())
  reviewId       String
  fieldKey       String
  extractedValue Json?
  finalValue     Json?
  confidence     Decimal?                 @db.Decimal(5, 4)
  changed        Boolean                  @default(false)
  review         DocumentValidationReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, fieldKey])
}

// ===== Aprovação =====
// Política de aprovação por empresa/moeda/faixa de valor (minAmount..maxAmount); priority ordena a escolha
// entre políticas aplicáveis e define as etapas (ApprovalPolicyStep).
model ApprovalPolicy {
  id        String               @id @default(cuid())
  name      String
  companyId String?
  currency  String               @default("BRL") @db.Char(3)
  minAmount Decimal              @default(0) @db.Decimal(19, 4)
  maxAmount Decimal?             @db.Decimal(19, 4)
  priority  Int                  @default(100)
  active    Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  company   Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  steps     ApprovalPolicyStep[]
  requests  ApprovalRequest[]

  @@index([companyId, currency, active, priority])
}

// Etapa de uma política: sequência e papel (Role) responsável por aprovar.
model ApprovalPolicyStep {
  id       String         @id @default(cuid())
  policyId String
  sequence Int
  roleId   String
  name     String
  policy   ApprovalPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  role     Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([policyId, sequence])
  @@index([roleId])
}

// Solicitação de aprovação de uma obrigação. Valor e moeda são congelados (snapshot) na abertura;
// currentStep aponta a etapa em andamento.
model ApprovalRequest {
  id                String                 @id @default(cuid())
  financialRecordId String
  policyId          String
  initiatedByUserId String
  status            ApprovalRequestStatus  @default(PENDING)
  currentStep       Int                    @default(1)
  amountSnapshot    Decimal                @db.Decimal(19, 4)
  currencySnapshot  String                 @db.Char(3)
  active            Boolean                @default(true)
  completedAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  financialRecord   FinancialRecord        @relation(fields: [financialRecordId], references: [id], onDelete: Cascade)
  policy            ApprovalPolicy         @relation(fields: [policyId], references: [id], onDelete: Restrict)
  initiatedBy       User                   @relation("ApprovalInitiator", fields: [initiatedByUserId], references: [id], onDelete: Restrict)
  steps             ApprovalStepInstance[]

  @@index([financialRecordId, active])
  @@index([status, createdAt])
}

// Catálogo comercial de treinamentos por fornecedor. Uma proposta agrupa os itens
// tabelados numa negociação (ex.: nº 898 da Massariol); uma nova tabela de preços
// gera uma nova proposta, nunca sobrescreve os itens de uma proposta anterior —
// preserva histórico comercial.
model TrainingProposal {
  id             String    @id @default(cuid())
  supplierId     String
  proposalNumber String
  proposalDate   DateTime?
  validityDays   Int?
  clientName     String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  supplier       AdministrativeEntity @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  trainings      Training[]

  @@unique([supplierId, proposalNumber])
  @@index([supplierId])
}

// Um item (treinamento) de uma proposta comercial. "additionalStudentPrice" e
// "unitPrice" são conceitos distintos do documento de origem (valor para incluir
// um aluno adicional x valor unitário do treinamento) e nunca devem ser derivados
// um do outro — em alguns itens da fonte eles divergem de propósito.
enum TrainingOrigin {
  IMPORTED
  MANUAL
}

// Item do catálogo de treinamentos (ver comentário acima de TrainingOrigin). sourceItemId = nº do item na
// proposta importada; origin indica se veio de importação (seed) ou de cadastro manual.
model Training {
  id                     String   @id @default(cuid())
  supplierId             String
  proposalId             String?
  sourceItemId           Int?
  origin                 TrainingOrigin @default(IMPORTED)
  description            String
  trainingType           String?
  duration               String?
  modality               String
  attendanceType         String
  additionalStudentPrice Decimal  @db.Decimal(19, 4)
  quantity               Int
  unitPrice              Decimal  @db.Decimal(19, 4)
  totalPrice             Decimal  @db.Decimal(19, 4)
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  supplier               AdministrativeEntity @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  proposal               TrainingProposal?    @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  expenses               TrainingExpense[]

  // supplierId+proposalId+sourceItemId continua protegendo duplicidade de
  // importação — NULLs em proposalId/sourceItemId (cadastro manual) nunca
  // colidem entre si nem com os itens importados, por semântica padrão do
  // Postgres (NULL é sempre distinto de NULL numa constraint única).
  @@unique([supplierId, proposalId, sourceItemId])
  @@index([supplierId])
  @@index([proposalId])
  @@index([modality, attendanceType])
}

// Status de um lançamento de treinamento: rascunho, concluído (gera obrigação) ou cancelado.
enum TrainingExpenseStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

// Competência do lançamento operacional de treinamento — mesmo padrão de
// FoodCompetence/TransitVoucherCompetence (um model por domínio, não
// compartilhado), para não acoplar despesas de domínios diferentes.
model TrainingExpenseCompetence {
  id        String            @id @default(cuid())
  year      Int
  month     Int
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  expenses  TrainingExpense[]

  @@unique([year, month])
}

// Um treinamento efetivamente realizado (despesa), distinto do catálogo
// (Training = "o que pode ser contratado"). Preços/quantidade-base são
// congelados em *Snapshot no momento da criação — nunca relidos do catálogo
// depois, mesmo que o preço do Training mude no futuro.
model TrainingExpense {
  id                            String                @id @default(cuid())
  competenceId                  String
  trainingId                    String
  supplierId                    String
  financialRecordId             String?               @unique
  trainingDate                  DateTime
  participantCount              Int                   @default(0)
  baseQuantitySnapshot          Int
  unitPriceSnapshot             Decimal               @db.Decimal(19, 4)
  additionalStudentPriceSnapshot Decimal              @db.Decimal(19, 4)
  calculatedAmount              Decimal               @db.Decimal(19, 4)
  finalAmount                   Decimal               @db.Decimal(19, 4)
  adjustmentReason              String?
  status                        TrainingExpenseStatus @default(DRAFT)
  createdByUserId               String
  cancelledAt                   DateTime?
  cancelledByUserId             String?
  cancellationReason            String?
  createdAt                     DateTime              @default(now())
  updatedAt                     DateTime              @updatedAt
  competence                    TrainingExpenseCompetence   @relation(fields: [competenceId], references: [id], onDelete: Restrict)
  training                      Training                    @relation(fields: [trainingId], references: [id], onDelete: Restrict)
  supplier                      AdministrativeEntity        @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  financialRecord                FinancialRecord?           @relation(fields: [financialRecordId], references: [id], onDelete: Restrict)
  createdBy                     User                        @relation("TrainingExpenseCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cancelledBy                   User?                       @relation("TrainingExpenseCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  participants                  TrainingExpenseParticipant[]
  revisions                     TrainingExpenseRevision[]

  @@index([competenceId])
  @@index([supplierId])
  @@index([trainingId])
  @@index([status])
}

// Participante de um lançamento — referencia sempre o Cadastro Mestre
// (FoodEmployee), nunca duplica colaborador. department/costCenter são
// snapshot do momento do lançamento (mesmo padrão de FoodAllocation.department),
// para a linha de rateio não mudar retroativamente se o colaborador for
// transferido de setor depois.
model TrainingExpenseParticipant {
  id                String          @id @default(cuid())
  trainingExpenseId String
  employeeId        String
  department        String
  costCenter        String
  allocatedAmount   Decimal         @db.Decimal(19, 4)
  createdAt         DateTime        @default(now())
  trainingExpense   TrainingExpense @relation(fields: [trainingExpenseId], references: [id], onDelete: Cascade)
  employee          FoodEmployee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@unique([trainingExpenseId, employeeId])
  @@index([employeeId])
  @@index([department])
}

// Auditoria de edição pós-conclusão — mesmo padrão de FoodBatchRevision.
model TrainingExpenseRevision {
  id                String          @id @default(cuid())
  trainingExpenseId String
  editedByUserId    String
  revision          Int
  previousTotal     Decimal         @db.Decimal(19, 4)
  newTotal          Decimal         @db.Decimal(19, 4)
  changes           Json
  createdAt         DateTime        @default(now())
  trainingExpense   TrainingExpense @relation(fields: [trainingExpenseId], references: [id], onDelete: Cascade)
  editedBy          User            @relation("TrainingExpenseRevisionEditor", fields: [editedByUserId], references: [id], onDelete: Restrict)

  @@unique([trainingExpenseId, revision])
  @@index([trainingExpenseId, createdAt])
}

// Instância de uma etapa de aprovação numa solicitação (cópia da ApprovalPolicyStep), com quem agiu e quando.
model ApprovalStepInstance {
  id            String             @id @default(cuid())
  requestId     String
  sequence      Int
  roleId        String
  name          String
  status        ApprovalStepStatus @default(WAITING)
  actedByUserId String?
  actedAt       DateTime?
  notes         String?
  request       ApprovalRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  role          Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  actedBy       User?              @relation("ApprovalActor", fields: [actedByUserId], references: [id], onDelete: Restrict)

  @@unique([requestId, sequence])
  @@index([roleId, status])
}

// ===== Plano de Saúde (Despesas) =====
// Competência (ano/mês, padrão = mês do vencimento) → Invoice (um PDF "Analítico Fatura Mensal" da operadora = uma
// obrigação financeira com o Valor Bruto da fatura) → Allocation (uma linha por TITULAR, valor = soma de Cobrado do
// titular e dependentes). Titular associado ao colaborador por CPF; empresa/CC/departamento são snapshot do cadastro
// no momento do upload. Titular não localizado fica com employeeId null (Sem empresa/CC/departamento) para o total fechar.
model HealthPlanCompetence {
  id          String                 @id @default(cuid())
  year        Int
  month       Int
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  invoices    HealthPlanInvoice[]
  allocations HealthPlanAllocation[]

  @@unique([year, month])
}

// Fatura do Plano de Saúde (um PDF da operadora) = uma obrigação financeira. obligation/control identificam a
// fatura no PDF; grossAmount é o Valor Bruto lido do PDF e totalAmount a soma dos titulares — o servidor exige
// que coincidam, e esse total vai para a obrigação. Cancelamento lógico (cancelled*).
model HealthPlanInvoice {
  id                     String               @id @default(cuid())
  competenceId           String
  administrativeEntityId String
  createdByUserId        String
  financialRecordId      String?              @unique
  fileName               String
  provider               String
  obligation             String
  control                String
  dueDate                DateTime?            @db.Date
  // Contratos ("Empresa" do PDF: código + nome) — só auditoria; a empresa do rateio vem do cadastro do colaborador.
  contracts              Json
  // Planos do resumo do PDF (código + nome), para exibir o nome no rateio.
  plans                  Json                 @default("[]")
  grossAmount            Decimal              @db.Decimal(19, 4)
  totalAmount            Decimal              @db.Decimal(19, 4)
  holderCount            Int
  beneficiaryCount       Int
  createdAt              DateTime             @default(now())
  cancelledAt            DateTime?
  cancelledByUserId      String?
  cancellationReason     String?
  competence             HealthPlanCompetence @relation(fields: [competenceId], references: [id], onDelete: Restrict)
  administrativeEntity   AdministrativeEntity @relation(fields: [administrativeEntityId], references: [id], onDelete: Restrict)
  createdBy              User                 @relation("HealthPlanInvoiceCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  cancelledBy            User?                @relation("HealthPlanInvoiceCanceller", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  financialRecord        FinancialRecord?     @relation(fields: [financialRecordId], references: [id], onDelete: Restrict)
  allocations            HealthPlanAllocation[]

  @@index([competenceId, administrativeEntityId])
  @@index([obligation])
}

// Linha do Plano de Saúde por titular; employeeId null quando o CPF não casou com nenhum colaborador.
model HealthPlanAllocation {
  id                     String               @id @default(cuid())
  invoiceId              String
  competenceId           String
  administrativeEntityId String
  sourceRow              Int
  // CPF do titular (11 dígitos) e beneficiários (linhas do PDF, com CPF/nome da mãe): dados pessoais, omitidos por
  // padrão no PrismaClient (src/lib/db/prisma.ts).
  holderCpf              String
  holderName             String
  employeeId             String?
  employeeName           String
  company                String
  companyId              String?
  department             String?
  costCenter             String?
  amount                 Decimal              @db.Decimal(19, 4)
  beneficiaryCount       Int
  // Lista dos beneficiários (titular e dependentes) da fatura com seus valores; contém dados pessoais.
  beneficiaries          Json
  createdAt              DateTime             @default(now())
  invoice                HealthPlanInvoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  competence             HealthPlanCompetence @relation(fields: [competenceId], references: [id], onDelete: Restrict)
  administrativeEntity   AdministrativeEntity @relation(fields: [administrativeEntityId], references: [id], onDelete: Restrict)
  employee               FoodEmployee?        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  companyRef             Company?             @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([employeeId])
  @@index([competenceId, administrativeEntityId])
}
